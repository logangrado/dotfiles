{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "packages": [
    "npm:pi-subagents",
    "npm:pi-web-access"
  ],
  "subagents": {
    "agentOverrides": {
      "worker": {
        "model": "openai/gpt-5.6-terra",
        "thinking": "high",
        "inheritGlobalContext": true
      },
      "reviewer": {
        "model": "openai/gpt-5.6-terra",
        "thinking": "high",
        "inheritGlobalContext": true
      }
    }
  }
}
